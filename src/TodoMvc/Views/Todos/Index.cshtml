@model IEnumerable<TodoMvc.Models.TodoItem>
@{
    ViewData["Title"] = "Tarefas";
    var pending = Model.Count(t => !t.IsDone);
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="h3 mb-1">Tarefas</h1>
        <p class="text-muted mb-4">@pending pendente(s) de @Model.Count()</p>

        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger py-2">@error</div>
        }

        <form asp-action="Create" method="post" class="d-flex gap-2 mb-4">
            <input name="Title" class="form-control" placeholder="O que precisa ser feito?" maxlength="200" required autofocus />
            <button type="submit" class="btn btn-primary text-nowrap">Adicionar</button>
        </form>

        @if (!Model.Any())
        {
            <p class="text-center text-muted py-5 border rounded">Nenhuma tarefa ainda.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var todo in Model)
                {
                    <li class="list-group-item d-flex align-items-center gap-3">
                        <form asp-action="Toggle" asp-route-id="@todo.Id" method="post">
                            <button type="submit" class="btn btn-sm @(todo.IsDone ? "btn-success" : "btn-outline-secondary")"
                                    title="@(todo.IsDone ? "Marcar como pendente" : "Marcar como concluída")">
                                @(todo.IsDone ? "Feita" : "Pendente")
                            </button>
                        </form>
                        <span class="flex-grow-1 @(todo.IsDone ? "text-decoration-line-through text-muted" : "")">@todo.Title</span>
                        <a asp-action="Edit" asp-route-id="@todo.Id" class="btn btn-sm btn-link">Editar</a>
                        <form asp-action="Delete" asp-route-id="@todo.Id" method="post"
                              onsubmit="return confirm('Excluir esta tarefa?');">
                            <button type="submit" class="btn btn-sm btn-link text-danger">Excluir</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </div>
</div>
