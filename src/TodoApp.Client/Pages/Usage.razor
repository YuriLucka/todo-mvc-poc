@page "/uso"
@inject UsageApiClient Api
@inject IConfiguration Config

<PageTitle>Uso do Supabase</PageTitle>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h1 class="h3 mb-0">Uso do Supabase</h1>
            <button class="btn btn-sm btn-outline-secondary" disabled="@loading" @onclick="LoadAsync">Atualizar</button>
        </div>
        <p class="text-muted mb-4">Consumo do plano Free em relação aos limites.</p>

        @if (error is not null)
        {
            <div class="alert alert-danger py-2">@error</div>
        }
        else if (usage is null)
        {
            <div class="d-flex align-items-center gap-2 text-muted py-4">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>Medindo consumo...</span>
            </div>
        }
        else
        {
            <UsageMeter Label="Banco de dados" Detail="Postgres: tabelas, índices e estruturas internas do Supabase"
                        Used="usage.DatabaseBytes" Limit="usage.DatabaseLimitBytes" />

            <UsageMeter Label="Storage" Detail="@($"{usage.StorageObjects} arquivo(s) armazenado(s)")"
                        Used="usage.StorageBytes" Limit="usage.StorageLimitBytes" />

            <div class="card mb-3">
                <div class="card-body">
                    <h2 class="h6 mb-2">Egress (dados que saem do Supabase)</h2>
                    <p class="text-muted small mb-2">
                        Limite de 5 GB por mês, acumulado e zerado a cada ciclo. O Supabase não expõe esse número
                        para a aplicação; ele fica disponível só no painel.
                    </p>
                    @if (Config["SupabaseUsageUrl"] is { Length: > 0 } usageUrl)
                    {
                        <a href="@usageUrl" target="_blank" rel="noopener" class="small">Ver egress no painel do Supabase</a>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body d-flex gap-4">
                    <div>
                        <div class="text-muted small">Tarefas</div>
                        <div class="fs-4 fw-semibold">@usage.Todos</div>
                    </div>
                    <div>
                        <div class="text-muted small">Concluídas</div>
                        <div class="fs-4 fw-semibold">@usage.TodosDone</div>
                    </div>
                </div>
            </div>

            <p class="text-muted small">
                Medido em @usage.MeasuredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss").
                A API guarda a medição por 1 minuto.
            </p>
        }
    </div>
</div>

@code {
    private UsageDto? usage;
    private string? error;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            usage = await Api.GetAsync();
        }
        catch (Exception)
        {
            error = "Não foi possível obter o consumo. A API pode estar acordando; tente de novo em instantes.";
        }
        finally
        {
            loading = false;
        }
    }
}
